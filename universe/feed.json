---
layout: null
permalink: /universe/feed.json
---
{%- assign featured = site.interviews | where: "featured", true | sort: "featured_order", "last" -%}
{%- assign all = site.interviews | sort: "date" | reverse -%}
{
  "updated": {{ site.time | date: "%Y-%m-%dT%H:%M:%S%z" | jsonify }},
  "featured": [
    {%- for it in featured limit: 4 %}
    {% include universe-feed-item.json it=it %}{% unless forloop.last %},{% endunless %}
    {%- endfor %}
  ],
  "latest": [
    {%- for it in all limit: 6 %}
    {% include universe-feed-item.json it=it %}{% unless forloop.last %},{% endunless %}
    {%- endfor %}
  ]
}
