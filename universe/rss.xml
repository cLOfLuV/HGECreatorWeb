---
layout: null
permalink: /universe/rss.xml
---
<?xml version="1.0" encoding="UTF-8"?>
{%- assign U = site.data.universe -%}
{%- assign all = site.interviews | sort: "date" | reverse %}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
<channel>
  <title>HGE Universe</title>
  <link>{{ "/universe/" | absolute_url }}</link>
  <atom:link href="{{ page.url | absolute_url }}" rel="self" type="application/rss+xml" />
  <description>{{ U.description | xml_escape }}</description>
  <language>ko</language>
  <lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>
  {%- if all.size > 0 %}
  {%- for it in all limit: 30 %}
  {%- assign desc = it.subtitle | default: it.lead | default: it.title %}
  <item>
    <title>{{ it.title | xml_escape }}</title>
    <link>{{ it.url | absolute_url }}</link>
    <guid isPermaLink="true">{{ it.url | absolute_url }}</guid>
    <pubDate>{{ it.date | date_to_rfc822 }}</pubDate>
    <category>{{ it.category }}</category>
    <description>{{ desc | strip_html | xml_escape }}</description>
  </item>
  {%- endfor %}
  {%- else %}
  {%- comment %} 공개된 인터뷰가 아직 없을 때: 빈 RSS는 네이버가 거부하므로 웹진 소개 페이지를 대신 넣음 {% endcomment %}
  <item>
    <title>HGE Universe — 크리에이터 인터뷰 웹진</title>
    <link>{{ "/universe/about/" | absolute_url }}</link>
    <guid isPermaLink="true">{{ "/universe/about/" | absolute_url }}</guid>
    <pubDate>{{ site.time | date_to_rfc822 }}</pubDate>
    <description>{{ U.description | xml_escape }}</description>
  </item>
  {%- endif %}
</channel>
</rss>
